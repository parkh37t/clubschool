# APEX 오케스트레이터 서버 환경변수 (복사해서 .env 로 쓰거나 셸에 export)
# .env 파일은 커밋 금지(.gitignore 처리됨). API 키는 절대 브라우저/프론트 코드에 두지 않는다.

# 실행 모드: mock(기본, 키 불필요, 배선 검증) | claude_code(이 PC 의 로그인된 Claude Code CLI — 권장) | live(Agent SDK + API 키)
OFFICE_MODE=mock

# live 모드에서만 필요. Anthropic 콘솔에서 발급한 키. claude_code 모드는 키가 필요 없다.
ANTHROPIC_API_KEY=

# (선택) claude CLI 경로. PATH 에 있으면 비워 둔다.
# Windows: PATH 에 없으면 Claude 데스크톱 앱 내장 CLI(%APPDATA%\Claude\claude-code\<버전>\<해시>\claude.exe)를 자동으로 찾는다.
# CLAUDE_BIN=

# (선택) 승인 대기 상한(ms). 0 = 재하가 누를 때까지 무한 대기(기본).
# OFFICE_APPROVAL_TIMEOUT_MS=0

# 서버 포트(기본 8787). Vite 프록시 대상과 일치해야 함.
PORT=8787

# (선택) 바인딩 주소. 비우면 모든 인터페이스. 이 PC 에서만 쓰려면 127.0.0.1
# OFFICE_HOST=127.0.0.1

# (선택) 브리핑 안에서 동시에 돌릴 작업 수(기본 2, 최대 3). 같은 담당자의 작업은 동시에 돌지 않는다.
# OFFICE_CONCURRENCY=2

# (선택) 데이터 위치. 비우면 server/hive · 저장소 DELIVERABLES · 저장소 dist
# OFFICE_HIVE_DIR=
# OFFICE_DELIVERABLES_DIR=
# OFFICE_DIST_DIR=

# (선택) 에이전트 실행 모델 별칭/ID. 미지정 시 SDK 기본값.
# OFFICE_MODEL=

# (선택) 작업 1건당 안전장치 — 에이전트가 헤매도 비용·시간이 무한정 늘지 않게 한다.
# 아래 두 금액은 기본값이고, 화면 모니터 탭에서 바꾼 값(hive/settings.json)이 우선한다.
# OFFICE_MAX_TOKENS=400000         # 작업 1건의 사용 토큰 한도(입력+캐시 생성+출력+캐시 읽기÷10). 넘으면 멈추고 '사용량' 승인 카드(승인 시 두 배로 이어서)
# OFFICE_AGENT_DAILY_TOKENS=1200000 # 에이전트 1명의 하루 사용 토큰 한도. 80% 제한(턴·한도 절반), 100% 중지(재하가 재개)
# OFFICE_MAX_TURNS=40       # 작업 1건 최대 대화 턴 수

# OFFICE_MAX_USD=2                 # live(API 키) 모드 전용 — 실제로 청구되는 API 요금의 작업당 상한(달러). claude_code 모드는 쓰지 않음

# (mock 시험용) 키 없이 사용 토큰 한도·질문 흐름을 확인할 때
# OFFICE_MOCK_TOKENS=500000 # 작업 1건이 쓴 것처럼 볼 사용 토큰. 한도보다 크면 '사용량' 승인 카드(합계에는 넣지 않음)
# OFFICE_MOCK_QUESTION=1    # 역할 에이전트 회신에 "재하에게 질문"을 한 줄 넣는다
